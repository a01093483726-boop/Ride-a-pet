-- 상태 변수
local isESPOn = false
local espCache = {}

local function createESP(targetPart, eggName)
    if espCache[targetPart] then return end
    
    local bill = Instance.new("BillboardGui")
    bill.Name = "EggESP_Tag"
    bill.Size = UDim2.new(0, 180, 0, 40)
    bill.AlwaysOnTop = true
    bill.Adornee = targetPart
    bill.StudsOffset = Vector3.new(0, 2, 0) -- 알 살짝 위쪽에 깔끔하게 뜨도록 위치 조정
    bill.Parent = ScreenGui
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 230, 0) -- 선명한 노란색
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.TextSize = 14
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = bill
    
    espCache[targetPart] = {Bill = bill, Label = textLabel}
end

local function removeESP(targetPart)
    if espCache[targetPart] then
        if espCache[targetPart].Bill then
            espCache[targetPart].Bill:Destroy()
        end
        espCache[targetPart] = nil
    end
end

-- 모든 ESP 태그 강제 청소
local function clearAllESP()
    for part, data in pairs(espCache) do
        if data.Bill then
            data.Bill:Destroy()
        end
    end
    espCache = {}
end

-- 버튼 클릭 시 ON / OFF 토글 제어
toggleButton.MouseButton1Click:Connect(function()
    isESPOn = not isESPOn
    if isESPOn then
        toggleButton.Text = "알 ESP: ON"
        toggleButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(20, 80, 20)
        print("알 ESP 켜짐")
    else
        toggleButton.Text = "알 ESP: OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        clearAllESP()
        print("알 ESP 꺼짐")
    end
end)

-- [2] 매 프레임 알 감지 및 겹침 방지 정밀 탐색
_G.RideAPetEggESPConnection = RunService.RenderStepped:Connect(function()
    if not isESPOn then return end

    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    -- 이미 등록된 알들 상태 체크 및 갱신
    for obj, data in pairs(espCache) do
        if not obj or not obj.Parent or not obj:IsA("BasePart") then
            removeESP(obj)
        else
            if rootPart then
                local distance = (rootPart.Position - obj.Position).Magnitude
                if distance < 3000 then
                    local distMeters = math.floor(distance / 3.5)
                    -- 오직 알 이름과 거리만 깔끔하게 출력
                    data.Label.Text = "🥚 " .. obj.Name .. " (" .. distMeters .. "m)"
                else
                    removeESP(obj)
                end
            end
        end
    end

    -- 새로운 알 탐색 (중복 생성 방지 필터링 강화)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            -- 알(Egg)이 확실하고, 중복 모델 파츠가 아닌 메인 파츠 위주로 엄선
            if string.find(lowerName, "egg") and not espCache[obj] then
                if rootPart then
                    local distance = (rootPart.Position - obj.Position).Magnitude
                    if distance < 3000 then
                        createESP(obj, obj.Name)
                    end
                end
            end
        end
    end
end)

print("겹침 방지 및 알 이름 중심 ESP 스크립트 로드 완료!")
