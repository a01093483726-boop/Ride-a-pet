-- 상태 변수
local isESPOn = false
local espCache = {}

local function createESP(targetPart, eggName)
    if espCache[targetPart] then return end
    
    local bill = Instance.new("BillboardGui")
    bill.Name = "EggESP_Tag"
    bill.Size = UDim2.new(0, 220, 0, 60)
    bill.AlwaysOnTop = true
    bill.Adornee = targetPart
    bill.Parent = ScreenGui
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 220, 0) -- 알은 눈에 잘 띄는 노란색/금색
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = bill
    
    espCache[targetPart] = {Bill = bill, Label = textLabel, Name = eggName}
end

local function removeESP(targetPart)
    if espCache[targetPart] then
        if espCache[targetPart].Bill then
            espCache[targetPart].Bill:Destroy()
        end
        espCache[targetPart] = nil
    end
end

-- 모든 ESP 태그 강제 청소
local function clearAllESP()
    for part, data in pairs(espCache) do
        if data.Bill then
            data.Bill:Destroy()
        end
    end
    espCache = {}
end

-- 버튼 클릭 시 ON / OFF 토글 제어
toggleButton.MouseButton1Click:Connect(function()
    isESPOn = not isESPOn
    if isESPOn then
        toggleButton.Text = "알 ESP: ON"
        toggleButton.TextColor3 = Color3.fromRGB(60, 255, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(20, 80, 20)
        print("알 ESP 켜짐")
    else
        toggleButton.Text = "알 ESP: OFF"
        toggleButton.TextColor3 = Color3.fromRGB(255, 60, 60)
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 20, 20)
        clearAllESP()
        print("알 ESP 꺼짐")
    end
end)

-- [2] 매 프레임 오직 '알(Egg)'들만 정밀 탐색 및 종류 표시
_G.RideAPetEggESPConnection = RunService.RenderStepped:Connect(function()
    if not isESPOn then return end

    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    
    -- 이미 캐시에 있는 알들이 실제로 여전히 존재하는지 체크하고 거리 갱신
    for obj, data in pairs(espCache) do
        if not obj or not obj.Parent then
            removeESP(obj)
        else
            if rootPart then
                local distance = (rootPart.Position - obj.Position).Magnitude
                if distance < 3000 then
                    local distMeters = math.floor(distance / 3.5)
                    -- 알 이름과 거리를 실시간으로 업데이트
                    data.Label.Text = "🥚 [" .. obj.Name .. "]\n거리: " .. distMeters .. "m"
                else
                    removeESP(obj)
                end
            end
        end
    end

    -- 새로운 알 탐색
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            
            -- 오직 이름에 "egg"가 포함된 오브젝트만 엄격하게 타겟팅!
            if string.find(lowerName, "egg") then
                if rootPart then
                    local distance = (rootPart.Position - obj.Position).Magnitude
                    
                    if distance < 3000 then
                        createESP(obj, obj.Name)
                    end
                end
            end
        end
    end
end)

print("오직 알(Egg)만 추적하는 맞춤형 ESP 스크립트 로드 완료!")
